# Replace /home/your-user with the service user's absolute home directory.
WIZARD_CERT=/home/your-user/.config/wizardcard-central-server/server.crt
WIZARD_KEY=/home/your-user/.config/wizardcard-central-server/server.key
WIZARD_DATA_DIR=/home/your-user/.local/share/wizardcard-central-server
WIZARD_BIND=0.0.0.0
WIZARD_PORT=24443
WIZARD_HEALTH_PORT=24444
