[Unit]
Description=WizardCard central game server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/wizardcard-central-server/server.env
ExecStart=%h/.local/opt/wizardcard-central-server/current/bin/wizard-server
Restart=on-failure
RestartSec=2s
TimeoutStopSec=20s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=%h/.config/wizardcard-central-server
ReadWritePaths=%h/.local/share/wizardcard-central-server
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=default.target
